# MCP Location Server

-include make/pipx.mk

.PHONY: check help install install-dev install-no-deps uninstall clean format format-check lint typecheck test test-verbose coverage mutation mutation-report

PACKAGE_NAME ?= mcp_location_server
SRC_DIR ?= src

ifeq ($(OS),Windows_NT)
    VENV_DIR ?= .venv
    PYTHON ?= $(VENV_DIR)/Scripts/python.exe
else
    VENV_DIR ?= .venv
    PYTHON ?= $(VENV_DIR)/bin/python
endif

$(info venv: $(VENV_DIR))

check: format lint typecheck test coverage  ## Run format, lint, typecheck, test, coverage (default)

.DEFAULT_GOAL := check

help:  ## Show available targets
	@grep -hE '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'

$(PYTHON):
	python3 -m venv $(VENV_DIR)

install:  ## Install package globally via uv tool
	python3 -m uv tool install --force .

install-dev: $(PYTHON)  ## Install in editable mode with dev deps
	$(PYTHON) -m pip install -e ".[dev]"

install-no-deps: $(PYTHON)  ## Install in editable mode without dependencies
	$(PYTHON) -m pip install -e . --no-deps

uninstall: $(PYTHON)  ## Uninstall package
	$(PYTHON) -m pip uninstall -y $(PACKAGE_NAME)

clean:  ## Remove build artifacts and caches
	rm -rf build/ dist/ *.egg-info $(SRC_DIR)/*.egg-info
	find . -type d -name __pycache__ -exec rm -r {} + 2>/dev/null || true
	find . -type f -name "*.pyc" -delete 2>/dev/null || true

format: install-dev  ## Format code with black
	$(PYTHON) -m black $(SRC_DIR)/$(PACKAGE_NAME) tests

format-check: install-dev  ## Check formatting without modifying files
	$(PYTHON) -m black --check $(SRC_DIR)/$(PACKAGE_NAME) tests

lint: install-dev  ## Lint with flake8
	$(PYTHON) -m flake8 --max-line-length=88 --extend-ignore=E203,W503 $(SRC_DIR)/$(PACKAGE_NAME) tests

typecheck: install-dev  ## Type check with mypy
	$(PYTHON) -m mypy $(SRC_DIR)/$(PACKAGE_NAME)

test: install-dev  ## Run pytest
	$(PYTHON) -m pytest

test-verbose: install-dev  ## Run pytest with verbose output
	$(PYTHON) -m pytest -v

coverage: install-dev  ## Run pytest with coverage (80% threshold)
	$(PYTHON) -m pytest --cov=$(PACKAGE_NAME) --cov-report=term --cov-fail-under=80

mutation: install-dev  ## Run mutation testing (not part of check — run in CI or on-demand)
	$(PYTHON) -m mutmut run --CI --paths-to-mutate "$(SRC_DIR)/$(PACKAGE_NAME)"

mutation-report: $(PYTHON)  ## Show results of last mutation run
	$(PYTHON) -m mutmut results

# --- Cursor integration (project-specific) ---

VENV_CURSOR_DIR ?= .venv-cursor

ifeq ($(OS),Windows_NT)
    VENV_CURSOR_PYTHON ?= $(VENV_CURSOR_DIR)/Scripts/python.exe
else
    VENV_CURSOR_PYTHON ?= $(VENV_CURSOR_DIR)/bin/python
endif

.PHONY: venv-cursor install-cursor clean-all

venv-cursor:  ## Create dedicated venv for Cursor with production deps only
	@if [ ! -d "$(VENV_CURSOR_DIR)" ]; then \
		python3 -m venv $(VENV_CURSOR_DIR); \
	fi

install-cursor: venv-cursor  ## Install MCP Location server for Cursor integration
	$(VENV_CURSOR_PYTHON) -m pip install -r requirements.txt
	$(VENV_CURSOR_PYTHON) -m pip install -e .
	@$(VENV_CURSOR_PYTHON) scripts/update_cursor_config.py "$$(pwd)/$(VENV_CURSOR_PYTHON)" "$$(realpath .)"

clean-all: clean  ## Clean up everything including Cursor venv
	rm -rf $(VENV_CURSOR_DIR)
